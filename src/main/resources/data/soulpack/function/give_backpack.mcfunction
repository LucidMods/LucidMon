# Upgrades are normal items and can safely use /give.
execute if score @s pk_join_given matches 1 run give @s sophisticatedbackpacks:inception_upgrade
execute if score @s pk_join_given matches 1 run give @s sophisticatedbackpacks:everlasting_upgrade

# Clear stale recovery state on a genuine first join.
scoreboard players set @s pk_pending 0
scoreboard players set @s pk_restored 0
scoreboard players reset @s pk_deaths

# Remove any stale/locked Soulpack recovery item near the joining player.
function soulpack:join_cleanup
schedule function soulpack:join_cleanup_late 5t replace
schedule function soulpack:join_cleanup_late 20t replace

execute if score @s pk_join_given matches 1 run tellraw @s {"text":"You've been given a soulbound backpack, an Inception Upgrade, and an Everlasting Upgrade.","color":"gold"}
execute if score @s pk_join_given matches 1 run tellraw @s {"text":"Install the Everlasting Upgrade in your backpack to keep it through death. Install the Inception Upgrade if you want the bag to hold other backpacks.","color":"yellow"}
execute if score @s pk_join_given matches 0 run tellraw @s {"text":"Soulpack could not find an empty inventory slot for your starter backpack.","color":"red"}
