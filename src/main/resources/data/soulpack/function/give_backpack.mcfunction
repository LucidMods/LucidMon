# v9: first-join starter grant
# Put the backpack directly into the first empty player inventory slot.
# This avoids creating a dropped backpack entity on join.
scoreboard players set @s pk_join_given 0
execute if score @s pk_join_given matches 0 unless items entity @s hotbar.8 * store success score @s pk_join_given run item replace entity @s hotbar.8 with sophisticatedbackpacks:iron_backpack[minecraft:custom_data={soulbound:1b}] 1
